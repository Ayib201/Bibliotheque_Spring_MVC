<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.groupeisi</groupId>
    <artifactId>bibliotheque</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>bibliotheque_mvc_jsp</name>
    <!-- packaging "pom" = ce module ne produit plus de .war lui-même, il ne fait
         qu'agréger et piloter les 4 vrais modules déclarés ci-dessous. -->
    <packaging>pom</packaging>

    <modules>
        <module>common</module>
        <module>repository</module>
        <module>metier</module>
        <module>ihm-jsp</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.source>21</maven.compiler.source>

        <!-- Versions centralisées : chaque module hérite de ces properties,
             on ne les écrit donc plus qu'à un seul endroit. -->
        <junit.version>5.11.0</junit.version>
        <spring.version>7.0.8</spring.version>
        <lombok.version>1.18.36</lombok.version>
        <hibernate.version>6.6.4.Final</hibernate.version>
        <postgresql.version>42.7.7</postgresql.version>
        <servlet.version>6.1.0</servlet.version>
        <jstl.version>3.0.1</jstl.version>
        <jstl-api.version>3.0.0</jstl-api.version>

        <!-- Versions de nos propres modules, utilisées quand un module dépend d'un autre -->
        <common.version>1.0-SNAPSHOT</common.version>
        <repository.version>1.0-SNAPSHOT</repository.version>
        <metier.version>1.0-SNAPSHOT</metier.version>
    </properties>

    <!-- dependencyManagement NE déclare aucune dépendance réelle : il fixe seulement
         les numéros de version à utiliser SI un module choisit d'ajouter la dépendance.
         Cela évite que deux modules utilisent deux versions différentes de Spring par erreur. -->
    <dependencyManagement>
        <dependencies>
            <!-- Nos modules internes -->
            <dependency>
                <groupId>com.groupeisi</groupId>
                <artifactId>common</artifactId>
                <version>${common.version}</version>
            </dependency>
            <dependency>
                <groupId>com.groupeisi</groupId>
                <artifactId>repository</artifactId>
                <version>${repository.version}</version>
            </dependency>
            <dependency>
                <groupId>com.groupeisi</groupId>
                <artifactId>metier</artifactId>
                <version>${metier.version}</version>
            </dependency>

            <!-- Bibliothèques tierces partagées -->
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>${servlet.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.glassfish.web</groupId>
                <artifactId>jakarta.servlet.jsp.jstl</artifactId>
                <version>${jstl.version}</version>
            </dependency>
            <!-- Depuis la 3.0.1, org.glassfish.web:jakarta.servlet.jsp.jstl déclare cette API
                 en scope "provided" dans son propre pom, donc Maven ne la propage plus dans le WAR.
                 On la redéclare explicitement (scope compile par défaut) pour que jakarta.servlet.jsp.jstl.core.Config
                 et les autres classes de l'API JSTL se retrouvent bien dans WEB-INF/lib. -->
            <dependency>
                <groupId>jakarta.servlet.jsp.jstl</groupId>
                <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
                <version>${jstl-api.version}</version>
            </dependency>
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-core</artifactId>
                <version>${hibernate.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-orm</artifactId>
                <version>${spring.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-webmvc</artifactId>
                <version>${spring.version}</version>
            </dependency>
            <!-- spring-context (@Configuration/@Service/@Controller...), spring-tx
                 (@Transactional) et spring-jdbc (DriverManagerDataSource) sont utilisées
                 directement par repository et/ou metier : ajoutées ici suite à la
                 vérification de l'étape 7 (elles manquaient au dependencyManagement,
                 ce qui aurait fait échouer le build : "dependency ... has no version"). -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-context</artifactId>
                <version>${spring.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-tx</artifactId>
                <version>${spring.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-jdbc</artifactId>
                <version>${spring.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-test</artifactId>
                <version>${spring.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- pluginManagement : même principe que dependencyManagement mais pour les plugins Maven.
         Chaque module (surtout ihm-jsp qui produira le .war final) pourra activer ces plugins
         sans redéfinir leur version ni leur configuration. -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <!-- Sans le flag -parameters, le bytecode compilé ne conserve pas les noms
                         des paramètres de méthode : Spring ne peut alors pas déduire tout seul
                         que le "id" de @PathVariable Long id correspond au "{id}" de l'URL,
                         d'où l'IllegalArgumentException au runtime. -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
