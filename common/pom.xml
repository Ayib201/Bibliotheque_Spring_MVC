<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.groupeisi</groupId>
    <artifactId>bibliotheque</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>common</artifactId>
  <name>common</name>
  <!-- Pas de packaging précisé => "jar" par défaut. common n'est pas une appli web,
       c'est une simple bibliothèque de classes partagées : DTOs, enums, contrats de mapping. -->

  <!-- Versions gérées localement à ce module, pas par le parent. -->
  <properties>
    <lombok.version>1.18.36</lombok.version>
    <junit.version>5.11.0</junit.version>
  </properties>

  <!-- common est volontairement au bas de la pyramide : aucune dépendance vers repository,
       metier ou les modules ihm-*. Tous les autres modules pourront dépendre de common,
       jamais l'inverse. -->
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
